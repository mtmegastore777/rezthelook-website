{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!email-confirmed(?:/|$)|reset-password(?:/|$)|stripe-return(?:/|$)|stripe-refresh(?:/|$)|subscribe(?:/|$)|subscribed(?:/|$)|subscribe-cancelled(?:/|$)|update-card(?:/|$)|pro(?:/|$)|assets(?:/|$)|api(?:/|$))[^./]+)",
      "destination": "/pro/index.html"
    }
  ]
}
